{
  "name": "proxy-manager-next",
  "version": "0.1.2",
  "private": true,
  "description": "Haruha cross-platform system proxy manager built with Tauri, React, and Rust",
  "license": "MIT",
  "keywords": [
    "tauri",
    "proxy",
    "pac",
    "react",
    "rust"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "check": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "release:verify-version": "bun scripts/verify-release-version.mjs",
    "test:release": "node scripts/normalize-github-release-assets.test.cjs",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "tauri:build:windows:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1 -Architecture all -Bundles all",
    "tauri:rebuild:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild-and-restart.ps1"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
